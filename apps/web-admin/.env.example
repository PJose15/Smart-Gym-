# ═══════════════════════════════════════════════════════════
# TIER 1: Public (safe for browser — NEXT_PUBLIC_ prefix)
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_APP_NAME=Nexera
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_DEV_OTP=false

# ═══════════════════════════════════════════════════════════
# TIER 2: Server-only (NEVER exposed to browser bundles)
# ═══════════════════════════════════════════════════════════

# — Supabase —
SUPABASE_SERVICE_ROLE_KEY=

# — AI (Gemini) —
GEMINI_API_KEY=

# — Payments (Stripe) —
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# — Push notifications (VAPID) —
VAPID_PRIVATE_KEY=

# — Internal services —
INTERNAL_WEBHOOK_KEY=

# — UptimizeAI agent engine —
# Staging: point at the dev echo receiver and set DEMO_ECHO_AGENTS=true:
#   UPTIMIZE_WEBHOOK_URL=http://localhost:3000/api/dev/agent-echo
# Going live: set UPTIMIZE_WEBHOOK_URL to the real UptimizeAI endpoint (contact UptimizeAI team
# for the URL + API key). No code changes required. Leave unset to disable forwarding entirely.
UPTIMIZE_WEBHOOK_URL=
UPTIMIZE_API_KEY=
DEMO_ECHO_AGENTS=false

# ═══════════════════════════════════════════════════════════
# TIER 3: Build-time only
# ═══════════════════════════════════════════════════════════
SENTRY_AUTH_TOKEN=
ANALYZE=false
