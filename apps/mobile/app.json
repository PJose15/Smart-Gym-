{
  "expo": {
    "name": "Nexera",
    "slug": "nexera",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nexera",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0f0f14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nexera.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Nexera needs camera access to scan QR codes on gym machines."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0f14"
      },
      "package": "com.nexera.app",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Nexera needs camera access to scan QR codes on gym machines."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3B8BD4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
